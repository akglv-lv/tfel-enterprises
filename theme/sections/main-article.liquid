<article class="wrap section narrow">
  <div class="page-head">
    <p class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}</p>
    <h1 class="page-title">{{ article.title }}</h1>
  </div>
  {%- if article.image -%}
    {{ article.image | image_url: width: 1400 | image_tag: widths: '600, 1000, 1400', class: 'article__img', alt: article.title }}
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="link-arrow" href="{{ blog.url }}">Back to {{ blog.title }}</a></p>
</article>

{% schema %}
{ "name": "Article", "tag": "div" }
{% endschema %}
