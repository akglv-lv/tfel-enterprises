<section class="wrap section narrow password">
  <span class="logo__text">FeLo</span>
  <h1 class="page-title">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'inline-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="notice">You're on the list.</p>
    {%- else -%}
      <label class="visually-hidden" for="PasswordEmail">Email</label>
      <input id="PasswordEmail" type="email" name="contact[email]" placeholder="Email for drop alerts" autocomplete="email" required>
      <button type="submit" class="btn">Notify me</button>
    {%- endif -%}
  {%- endform -%}

  <details class="product__details">
    <summary>Store owner? Enter the password</summary>
    {%- form 'storefront_password', class: 'inline-form' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="StorePassword">Password</label>
      <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="btn btn--ghost">Enter</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Next drop soon" }]
}
{% endschema %}
