{%- paginate blog.articles by 12 -%}
  <section class="wrap section">
    <div class="page-head"><h1 class="page-title">{{ blog.title }}</h1></div>
    <div class="collection-list">
      {%- for article in blog.articles -%}
        <a class="collection-card" href="{{ article.url }}">
          {%- if article.image -%}
            <div class="collection-card__pic">
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: article.title }}
            </div>
          {%- endif -%}
          <b>{{ article.title }}</b>
          <small>{{ article.published_at | date: '%B %-d, %Y' }}</small>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "div" }
{% endschema %}
