<section class="wrap section">
  <div class="page-head"><h1 class="page-title">{{ section.settings.heading | escape }}</h1></div>
  <div class="collection-list">
    {%- for c in collections -%}
      {%- if c.products_count > 0 and c.handle != 'frontpage' -%}
        <a class="collection-card" href="{{ c.url }}">
          <div class="collection-card__pic">
            {%- assign img = c.image | default: c.products.first.featured_media -%}
            {%- if img -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: c.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <b>{{ c.title }}</b>
          <small>{{ c.products_count }} piece{% if c.products_count != 1 %}s{% endif %}</small>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "All collections",
  "tag": "div",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "All collections" }]
}
{% endschema %}
