<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500&display=swap">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      :root { --a: {{ settings.color_a }}; --b: {{ settings.color_b }}; --logo-width: {{ settings.logo_width }}px; }
    </style>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
