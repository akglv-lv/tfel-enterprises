{%- comment -%}
  Turns a colour name from the product options into a dot colour.
  The names are the ones the print supplier uses on tfelent.com today.
  A name that isn't listed gets a neutral grey dot, so new colours never break the page.
  Usage: {% render 'swatch-color', name: value %}
{%- endcomment -%}
{%- liquid
  assign key = name | downcase | strip
  case key
    when 'black'
      echo '#111114'
    when 'vintage black'
      echo '#2E2D30'
    when 'white'
      echo '#FFFFFF'
    when 'navy', 'navy blazer'
      echo '#1F2640'
    when 'maroon'
      echo '#5C1F2E'
    when 'charcoal', 'charcoal heather'
      echo '#46474D'
    when 'carbon grey', 'dark grey'
      echo '#5C5E64'
    when 'sky blue', 'sky'
      echo '#A9CDEB'
    when 'light blue'
      echo '#B9D6EE'
    when 'carolina blue'
      echo '#80B3E0'
    when 'harbor blue'
      echo '#3F6F90'
    when 'pacific blue'
      echo '#4C8FC3'
    when 'team royal', 'royal'
      echo '#2148A6'
    when 'purple'
      echo '#583A8A'
    when 'dusty rose'
      echo '#D6A29F'
    when 'pink'
      echo '#F2A6C0'
    when 'light pink'
      echo '#F5C7D4'
    when 'azalea'
      echo '#F28EB5'
    when 'coral'
      echo '#F27A66'
    when 'red', 'team red'
      echo '#C21F2D'
    when 'cardinal', 'cranberry'
      echo '#8A1F32'
    when 'orange'
      echo '#EF7A2B'
    when 'squash'
      echo '#F1A93B'
    when 'forest green'
      echo '#23442F'
    when 'military green'
      echo '#5A5E3C'
    when 'spruce'
      echo '#2F4A3F'
    when 'mint'
      echo '#AADFC8'
    when 'bone', 'natural'
      echo '#ECE3D1'
    when 'sand', 'stone'
      echo '#D6C8AA'
    when 'dark chocolate'
      echo '#3C2A22'
    when 'brown savana'
      echo '#8A6F56'
    else
      echo '#8E8C9E'
  endcase
-%}
